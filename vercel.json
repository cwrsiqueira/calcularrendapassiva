{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.calcularrendapassiva.com"
        }
      ],
      "destination": "https://calcularrendapassiva.com/:path*",
      "permanent": true
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/artigos/o-que-e-renda-passiva-e-como-calcular",
      "destination": "/articles/o-que-e-renda-passiva",
      "permanent": true
    },
    {
      "source": "/en/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/contact",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/en/privacy",
      "destination": "/en/terms.html",
      "permanent": true
    },
    {
      "source": "/contato",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sobre",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/termos-de-uso-e-politicas-de-privacidade.html",
      "permanent": true
    },
    {
      "source": "/termos-de-uso",
      "destination": "/termos-de-uso-e-politicas-de-privacidade.html",
      "permanent": true
    },
    {
      "source": "/articles/best-dividend-etfs",
      "destination": "/en/articles/best-dividend-etfs",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.(?:js|css|png|jpg|jpeg|ico|svg|woff|woff2|ttf|gif|webp))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
